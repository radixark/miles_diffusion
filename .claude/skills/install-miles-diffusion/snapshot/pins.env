# Pins pip cannot express. Written as ${KEY:-default} so the environment can override any of
# them for a one-off run. refresh.sh rewrites the derivable ones.

OFFICIAL_IMAGE="${OFFICIAL_IMAGE:-radixark/miles_diffusion:dev-cu129-sglang-main-20260818}"

# Ubuntu 24.04's system python; miles' setup.py requires >=3.12. pip excludes itself from
# `pip freeze`, so its pin lives here rather than in packages.txt.
PY_VER="${PY_VER:-3.12}"
PIP_VER="${PIP_VER:-26.1.1}"

SGLANG_REPO="${SGLANG_REPO:-https://github.com/sgl-project/sglang.git}"
SGLANG_BRANCH="${SGLANG_BRANCH:-sglang-miles-h3}"
SGLANG_DIR="${SGLANG_DIR:-/sgl-workspace/sglang}"
SGLANG_COMMIT="${SGLANG_COMMIT:-94eef833fe40460230cd6856e2602e038c8305e0}"

MILES_BRANCH="${MILES_BRANCH:-main}"

# The prebuilt Hopper FA3 wheel, same release the Dockerfile pulls from. packages.txt carries the
# resolved asset URL; these record where it came from.
FA3_WHEELS_REPO="${FA3_WHEELS_REPO:-yueming-yuan/miles-wheels}"
FA3_WHEELS_TAG="${FA3_WHEELS_TAG:-cu129-x86_64}"

TORCH_INDEX="${TORCH_INDEX:-https://download.pytorch.org/whl/cu129}"
SGLANG_KERNEL_INDEX="${SGLANG_KERNEL_INDEX:-https://docs.sglang.io/whl/cu129}"
FLASHINFER_INDEX="${FLASHINFER_INDEX:-https://flashinfer.ai/whl/cu129}"

# The image's resolved FA3 kernel hashes go here, so the hub loader never resolves a new snapshot.
KERNELS_LOCK_DEST="${KERNELS_LOCK_DEST:-/root/.cache/sglang/kernels.lock}"
PADDLEOCR_LANG="${PADDLEOCR_LANG:-en}"
